# GEMINI_API_KEY: Configure only if the app uses Gemini API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted.
APP_URL="MY_APP_URL"

# Set this after the PHP API is uploaded and reachable on InfinityFree.
# Example: https://api.yourdomain.com
VITE_API_BASE_URL=
